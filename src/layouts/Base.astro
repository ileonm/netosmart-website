---
import '../styles/global.css';
import { sitio, navegacion } from '../config/site';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canonica. Si se omite, se usa la ruta actual. */
  canonica?: string;
  /** true en las paginas de canal, que son copias del inicio. */
  noIndexar?: boolean;
}

const { titulo, descripcion, canonica, noIndexar = false } = Astro.props;

// Se calcula al construir el sitio, asi que se actualiza solo en cada despliegue.
const anio = new Date().getFullYear();

const rutaActual = Astro.url.pathname.replace(/\/+$/, '') || '/';
const urlCanonica = new URL(canonica ?? rutaActual, sitio.dominio).href;
const urlImagen = new URL('/og.png', sitio.dominio).href;
const tituloCompleto =
  titulo === sitio.nombre ? titulo : `${titulo} | ${sitio.nombre}`;
---

<!doctype html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    {noIndexar && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1a1a2e" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph. Casi todas las visitas llegan por un enlace compartido. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Neto Smart. Trabajaste diez horas. Cuanto te quedo."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagen} />

    <link rel="icon" href="/icono-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icono-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icono-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="encabezado">
      <div class="envoltura">
        <a class="marca" href="/">
          <img class="logo" src="/logo-96.png" width="32" height="32" alt="" />
          <span>Neto Smart</span>
        </a>
        <nav aria-label="Principal">
          <a
            href="/descargar"
            class="enlace-descarga"
            aria-current={rutaActual === '/descargar' ? 'page' : undefined}
          >
            Descargar
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="envoltura">
        <h2>Neto Smart</h2>
        <p style="max-width: 34rem;">
          Hecha por conductores, para conductores. Desde Costa Rica.
        </p>
        <nav aria-label="Pie de pagina">
          <ul>
            {
              navegacion.map((enlace) => (
                <li>
                  <a href={enlace.url}>{enlace.texto}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          sitio.correoContacto && (
            <p>
              <a href={`mailto:${sitio.correoContacto}`}>
                {sitio.correoContacto}
              </a>
            </p>
          )
        }

        <div class="legal-pie">
          <p>
            <small>
              &copy; {anio} Neto Smart{sitio.simboloMarca}. Todos los derechos
              reservados.
            </small>
          </p>
          <p class="sin-margen">
            <small>
              Neto Smart no tiene relación con Uber, DiDi ni InDrive. Esas
              marcas son de sus dueños y se mencionan solo para explicar con
              cuáles aplicaciones funciona.
            </small>
          </p>
        </div>
      </div>
    </footer>

    {
      sitio.tokenAnalytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${sitio.tokenAnalytics}"}`}
        />
      )
    }
  </body>
</html>
