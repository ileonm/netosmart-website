---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Landing from '../../components/Landing.astro';
import { canales } from '../../config/canales';
import { sitio } from '../../config/site';

/**
 * Una pagina por canal de lanzamiento. Muestra lo mismo que el inicio.
 * Sirve solo para medir de donde viene la gente: cada canal aparece con su
 * propia direccion en las estadisticas.
 *
 * No se indexan en Google (llevan noindex) y le dicen a Google que la pagina
 * buena es "/", para no partir el posicionamiento en nueve copias.
 */
export const getStaticPaths = (() =>
  canales.map((c) => ({ params: { canal: c.id } }))) satisfies GetStaticPaths;
---

<Base
  titulo="Cuánto te queda libre manejando en Costa Rica"
  descripcion={`Neto Smart es una app para conductores de Uber, DiDi e InDrive en Costa Rica: descuenta gasolina, peajes, mantenimiento y costos fijos y te dice cuánto te quedó de verdad. Para Android, con plan gratis y Pro con ${sitio.diasPrueba} días de prueba.`}
  canonica="/"
  noIndexar={true}
>
  <Landing />
</Base>
