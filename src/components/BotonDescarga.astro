---
import { sitio } from '../config/site';

interface Props {
  texto?: string;
  /** Si es false, no muestra la linea de abajo ("Gratis. Para Android..."). */
  detalle?: boolean;
  ancho?: boolean;
  /**
   * true lleva a /descargar (la pagina con los primeros pasos).
   * false manda directo a la tienda.
   */
  aInstrucciones?: boolean;
}

const {
  texto = 'Descargar Neto Smart',
  detalle = true,
  ancho = false,
  aInstrucciones = true,
} = Astro.props;

const destino = aInstrucciones ? '/descargar' : sitio.urlPlayStore;
---

<a
  class:list={['boton', { ancho }]}
  href={destino}
  {...aInstrucciones ? {} : { rel: 'noopener' }}
>
  {texto}
</a>
{
  sitio.urlAppStore && (
    <a class:list={['boton', 'secundario', { ancho }]} href={sitio.urlAppStore} rel="noopener">
      Descargar para iPhone
    </a>
  )
}
{
  detalle && (
    <p class="bajo-boton">
      {sitio.urlAppStore
        ? 'Gratis. Para Android y para iPhone.'
        : 'Gratis, en Google Play. La versión para iPhone viene en camino.'}
    </p>
  )
}
