---
import { sitio } from '../config/site';
import InsigniaPlay from './InsigniaPlay.astro';

/**
 * El bloque de descarga: la insignia de Google Play y, debajo, una linea que
 * dice lo que el conductor quiere saber antes de tocarla.
 */
interface Props {
  /** Si es false, no muestra la linea de abajo. */
  detalle?: boolean;
  /** Enlace a /descargar, donde se explica que permisos pide la app. */
  masInfo?: boolean;
  /** true para los que quedan debajo de la primera pantalla. */
  diferida?: boolean;
}

const { detalle = true, masInfo = true, diferida = false } = Astro.props;
---

<InsigniaPlay diferida={diferida} />
{
  sitio.urlAppStore && (
    <a class="boton secundario" href={sitio.urlAppStore} rel="noopener">
      Descargar para iPhone
    </a>
  )
}
{
  detalle && (
    <p class="bajo-boton">
      {sitio.urlAppStore
        ? `Gratis en Google Play y en la App Store. Premium con ${sitio.diasPrueba} días de prueba, sin tarjeta.`
        : `Gratis en Google Play. Premium con ${sitio.diasPrueba} días de prueba, sin tarjeta. La versión para iPhone viene en camino.`}
      {masInfo && (
        <>
          {' '}
          <a href="/descargar">Qué te va a pedir la app</a>.
        </>
      )}
    </p>
  )
}
