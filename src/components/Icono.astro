---
/**
 * Iconos dibujados a mano en SVG, dentro del HTML.
 *
 * Van en linea a proposito: no son archivos, no se bajan de ningun lado y no
 * suman ni una peticion. Todos pesan menos que una letra de una fuente de
 * iconos.
 *
 * Usan currentColor, asi que toman el color del texto que tengan alrededor y
 * funcionan igual en modo claro y oscuro.
 */
interface Props {
  nombre:
    | 'ojo'
    | 'peaje'
    | 'reloj'
    | 'gasolina'
    | 'billete'
    | 'casa'
    | 'alcancia'
    | 'carro'
    | 'sinsenal'
    | 'turno'
    | 'volante'
    | 'neto';
  tamano?: number;
}
const { nombre, tamano = 24 } = Astro.props;

// Cada icono es un trazo simple sobre una rejilla de 24 por 24.
const trazos: Record<Props['nombre'], string> = {
  // Un ojo: la app mira la pantalla
  ojo: '<path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z"/><circle cx="12" cy="12" r="2.6"/>',
  // Una barrera de peaje
  peaje: '<path d="M4 21V9"/><path d="M4 6.5h16l-2.5 4H4"/><path d="M2 21h20"/><path d="M14 21v-4.5h6V21"/>',
  // Un reloj marcando la medianoche
  reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7.2V12l3.2 2"/>',
  // Una bomba de gasolina
  gasolina: '<path d="M3 21V5.5A2.5 2.5 0 0 1 5.5 3h5A2.5 2.5 0 0 1 13 5.5V21"/><path d="M2 21h12"/><path d="M6 9h4"/><path d="M13 10h4.5a2 2 0 0 1 2 2v4a1.8 1.8 0 0 0 3.5.6"/>',
  // Billetes
  billete: '<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 12h.01M18 12h.01"/>',
  // Una casa
  casa: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.8V21h14V9.8"/><path d="M10 21v-6h4v6"/>',
  // Una alcancia, para los apartados
  alcancia: '<path d="M3 21v-3.2A6.8 6.8 0 0 1 9.8 11h4.4a6.8 6.8 0 0 1 6.8 6.8V21"/><path d="M3 21h4v-2M17 21h4v-2"/><path d="M11 7.5A2.5 2.5 0 0 1 16 7"/><path d="M17 15h.01"/>',
  // Un carro visto de lado
  carro: '<path d="M3 16.5v-3l2.2-5A2 2 0 0 1 7.1 7h9.8a2 2 0 0 1 1.9 1.5l2.2 5v3"/><path d="M3 13.5h18"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>',
  // Senal tachada
  sinsenal: '<path d="M2 2l20 20"/><path d="M5 12.5a10 10 0 0 1 3.6-2.3"/><path d="M1.6 9a15 15 0 0 1 4.2-2.8"/><path d="M12 19h.01"/><path d="M15.6 10.4A10 10 0 0 1 19 12.5"/><path d="M12.6 6.1A15 15 0 0 1 22.4 9"/>',
  // Un turno que arranca
  turno: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5l6 3.5-6 3.5Z"/>',
  // Un volante
  volante: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v6M4.2 16.5l5.2-3M19.8 16.5l-5.2-3"/>',
  // Una cuenta cerrada, con el visto bueno
  neto: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h4"/><path d="M8.5 16.5l2 2 4-4"/>',
};
---

<svg
  class="icono"
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={trazos[nombre]}
/>
