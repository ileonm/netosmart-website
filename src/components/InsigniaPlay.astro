---

/**
 * La insignia OFICIAL de Google Play ("Descargar en Google Play"), en espanol.
 *
 * Es el archivo original de Google (public/google-play-es.png) y NO se toca: no
 * se redibuja, no se recolorea, no se le pone sombra ni filtros. Google tiene
 * reglas de uso de marca para esta insignia, y una de ellas es la linea de
 * atribucion que va en el pie (ver Base.astro).
 *
 * Enlaza a la ficha de la app en Google Play pasando por /ir/play, una
 * pagina de paso que cuenta el clic en las estadisticas (ver ir/[destino]).
 */
interface Props {
  /** true para las que quedan debajo de la primera pantalla. */
  diferida?: boolean;
}
const { diferida = false } = Astro.props;
---

<a class="insignia" href="/ir/play" rel="noopener">
  <img
    src="/google-play-es.png"
    width="165"
    height="64"
    alt="Descargar en Google Play"
    loading={diferida ? 'lazy' : undefined}
    decoding="async"
  />
</a>
